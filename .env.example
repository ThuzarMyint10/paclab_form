APP_NAME="Pacific Lab Services"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Singapore
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- MySQL database ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paclab
DB_USERNAME=root
DB_PASSWORD=coolx5000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---- Email (SMTP) ----
# While testing, MAIL_MAILER=log writes every email to storage/logs/laravel.log
# For live use set MAIL_MAILER=smtp and fill in your mail server details.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.zagro.com
MAIL_PORT=587
MAIL_USERNAME=support@zagro.com
MAIL_PASSWORD=LowerLa&136
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@zagro.com"
MAIL_FROM_NAME="Pacific Lab Services"

# ---- PacLab specific ----
# Comma-separated list of staff who receive "new enquiry" and "quotation approved/declined" emails
PACLAB_ADMIN_EMAILS="paclab@pacificlab.com.sg"
# First admin account created by the seeder (change the password after first login)
PACLAB_SEED_ADMIN_EMAIL="admin@pacificlab.com.sg"
PACLAB_SEED_ADMIN_PASSWORD="ChangeMe@2026"
